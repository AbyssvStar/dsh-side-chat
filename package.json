{
  "name": "@abyssvstar/dsh-side-chat",
  "version": "0.1.0",
  "description": "Codex-style side chat for the DSH web GUI: fork any turn into a right-sidebar chat, keep the main line untouched, and bring the conclusion back on demand.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbyssvStar/dsh-side-chat.git"
  },
  "homepage": "https://github.com/AbyssvStar/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/AbyssvStar/dsh-side-chat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "side-chat",
    "codex",
    "sidebar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs",
    "check": "node scripts/check-dsh-compat.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
